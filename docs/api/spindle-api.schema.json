{
  "name": "spindle-control-api",
  "protocol": 1,
  "schema_version": 1,
  "transport": "newline-delimited JSON over the local control endpoint",
  "request": { "version": "u16", "request_id": "string", "op": "string", "payload": "object" },
  "response": { "version": "u16", "request_id": "string", "ok": "boolean", "payload": "object|null", "error": "{code:string,message:string}|null" },
  "operations": {
    "ping": {}, "attach": {}, "detach": {}, "get_snapshot": {}, "stream_events": {}, "subscribe_events": {},
    "create_space": {}, "switch_space": {}, "rename_space": {}, "delete_space": {},
    "create_workspace": {}, "switch_workspace": {}, "focus_workspace": {}, "rename_workspace": {}, "move_workspace": {}, "delete_workspace": {},
    "create_tab": {}, "switch_tab": {}, "rename_tab": {}, "move_tab": {}, "close_tab": {},
    "create_pane": {
      "payload": {
        "type": "object",
        "required": ["command", "cwd", "cols", "rows"],
        "properties": {
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "cols": { "type": "integer", "minimum": 1 },
          "rows": { "type": "integer", "minimum": 1 },
          "popup": { "type": "boolean", "default": false },
          "overlay": { "type": "boolean", "default": false }
        }
      }
    }, "ensure_active_pane": {}, "split_pane": {}, "send_input": {}, "resize_pty": {},
    "stop_pane": {}, "restart_pane": {}, "focus_pane": {}, "swap_panes": {}, "rename_pane": {},
    "toggle_pane_zoom": {}, "toggle_right_click_passthrough": {}, "set_right_click_passthrough": {}, "move_pane": {}, "focus_next": {}, "focus_previous": {},
    "focus_direction": {}, "resize_pane": {}, "resize_pane_direction": {}, "set_split_ratio": {}, "close_pane": {}, "close_popup": {}, "close_overlay": {},
    "report_agent": {
      "payload": {
        "type": "object",
        "required": ["pane_id", "source", "agent", "state"],
        "properties": {
          "pane_id": { "type": "string" },
          "source": { "type": "string" },
          "agent": { "type": "string" },
          "state": { "enum": ["unknown", "idle", "working", "blocked"] },
          "seq": { "type": ["integer", "null"], "minimum": 0 },
          "agent_session_id": { "type": ["string", "null"] },
          "agent_session_path": { "type": ["string", "null"] }
        }
      }
    },
    "report_agent_session": {
      "payload": {
        "type": "object",
        "required": ["pane_id", "source", "agent"],
        "properties": {
          "pane_id": { "type": "string" },
          "source": { "type": "string" },
          "agent": { "type": "string" },
          "seq": { "type": ["integer", "null"], "minimum": 0 },
          "agent_session_id": { "type": ["string", "null"] },
          "agent_session_path": { "type": ["string", "null"] }
        },
        "anyOf": [
          { "required": ["agent_session_id"] },
          { "required": ["agent_session_path"] }
        ]
      }
    },
    "report_metadata": {
      "payload": {
        "type": "object",
        "required": ["pane_id", "source"],
        "properties": {
          "pane_id": { "type": "string" },
          "source": { "type": "string" },
          "display_agent": { "type": ["string", "null"] },
          "clear_display_agent": { "type": "boolean", "default": false },
          "display_title": { "type": ["string", "null"] },
          "clear_title": { "type": "boolean", "default": false },
          "seq": { "type": ["integer", "null"], "minimum": 0 }
        },
        "anyOf": [
          { "required": ["display_agent"] },
          { "required": ["clear_display_agent"] }
        ]
      }
    },
    "release_agent": {
      "payload": {
        "type": "object",
        "required": ["pane_id", "source", "agent"],
        "properties": {
          "pane_id": { "type": "string" },
          "source": { "type": "string" },
          "agent": { "type": "string" },
          "seq": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "stop_server": {}
  }
}
